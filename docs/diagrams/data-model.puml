@startuml
!pragma layout smetana
hide circle
hide empty members
skinparam BackgroundColor #F8FAFC
skinparam DefaultFontName SansSerif
skinparam DefaultFontColor #17314A
skinparam DefaultFontSize 15
skinparam Shadowing false
skinparam ArrowColor #475569
skinparam ArrowFontColor #334155
skinparam ArrowFontSize 13
skinparam ClassBackgroundColor #E6F0F7
skinparam ClassBorderColor #456C87
skinparam ClassAttributeFontSize 13
skinparam nodesep 35
skinparam ranksep 54

class automations {
  tenant_id : text
  account_id : text
  enabled : boolean
}

class automation_versions {
  id : uuid {id}
  revision : integer
  post_id : text [0..1]
  link_url : text
  collect_participant_context : boolean
  returning_email_prompt : text [0..1]
}

class inbox {
  tenant_id : text
  account_id : text
  event_id : text
  kind : text
  object_id : text
  post_id : text [0..1]
}

class runs {
  id : uuid {id}
  participant_id : text
  comment_id : text
  state : text
  started_at : timestamptz
  collect_participant_context : boolean
}

class participant_interactions {
  tenant_id : text
  account_id : text
  participant_id : text
  event_id : text
  run_id : uuid
  occurred_at : timestamptz
  excerpt : text
  pending_prompt : boolean
}

class buffered_emails {
  run_id : uuid {id}
  email : text
}

class leads {
  run_id : uuid {id}
  email : text
}

class outbox {
  id : uuid {id}
  tenant_id : text
  account_id : text
  kind : text
  status : text
  send_before : timestamptz
  attempts : integer
}

class delivery_lanes {
  pending_count : bigint
  turn : bigint
}

class delivery_cooldowns {
  until_at : timestamptz
}

class delivery_reconciliations {
  action_id : uuid
  attempt : integer
  decision : text
}

automations "1" -down- "0..*" automation_versions : published versions
automations "0..1" -down- "0..1" automation_versions : current version
automations "1" -up- "0..1" delivery_lanes : scheduling lane
automations "1" -right- "0..1" delivery_cooldowns : cooldown
automation_versions "1" -down- "0..*" runs : pinned version
runs "1" -left- "0..1" buffered_emails : buffered address
runs "1" -right- "0..1" leads : captured address
runs "1" -down- "0..3" outbox : requested actions
participant_interactions "0..*" -up- "1" runs : retained excerpts
participant_interactions "0..1" -left- "1" inbox : source receipt
participant_interactions -[hidden]right- outbox
outbox "1" -down- "0..*" delivery_reconciliations : decisions
@enduml
